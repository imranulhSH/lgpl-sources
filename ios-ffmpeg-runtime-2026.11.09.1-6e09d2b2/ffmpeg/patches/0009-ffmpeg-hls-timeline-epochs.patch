+static int reopen_discontinuity_epoch(struct playlist *pls)
+{
+    const AVInputFormat *format = pls->ctx->iformat;
+    HLSContext *c = pls->parent->priv_data;
+    struct segment *seg = current_segment(pls);
+    AVDictionary *options = NULL;
+    int ret;
+    int64_t start;
+    if (!seg) return AVERROR_INVALIDDATA;
+    if ((ret = validate_epoch_end(pls, seg->timeline_start)) < 0) return ret;
+    if (!pls->epoch_origin_valid) {
+        start = epoch_presentation_start(pls->ctx);
+        if (start == AV_NOPTS_VALUE || start < INT64_MIN + pls->epoch_started_at)
+            return AVERROR_INVALIDDATA;
+        pls->epoch_origin = start - pls->epoch_started_at;
+        pls->epoch_origin_valid = 1;
+    }
+    for (unsigned n = 0; n < pls->ctx->nb_streams; n++) {
+        if (n >= 64) return AVERROR(ENOSPC);
+        if (!pls->stream_origin_valid[n] && pls->ctx->streams[n]->start_time != AV_NOPTS_VALUE) {
+            pls->stream_origins[n] = av_rescale_q(pls->ctx->streams[n]->start_time,
+                pls->ctx->streams[n]->time_base, AV_TIME_BASE_Q) - pls->epoch_started_at;
+            int64_t epoch_ticks = av_rescale_q(pls->epoch_started_at, AV_TIME_BASE_Q, pls->ctx->streams[n]->time_base);
+            if (epoch_ticks < 0 || pls->ctx->streams[n]->start_time < INT64_MIN + epoch_ticks)
+                return AVERROR_INVALIDDATA;
+            pls->stream_origin_ticks[n] = pls->ctx->streams[n]->start_time - epoch_ticks;
+            pls->stream_origin_valid[n] = 1;
+        }
+    }
+    ff_format_io_close(pls->parent, &pls->input);
+    ff_format_io_close(pls->parent, &pls->input_next);
+    pls->input_read_done = 0;
+    pls->input_next_requested = 0;
+    pls->ctx->pb = NULL;
+    avformat_close_input(&pls->ctx);
+    av_freep(&pls->pb.pub.buffer);
+    pls->read_buffer = av_malloc(INITIAL_BUFFER_SIZE);
+    if (!pls->read_buffer) return AVERROR(ENOMEM);
+    ffio_init_context(&pls->pb, pls->read_buffer, INITIAL_BUFFER_SIZE, 0, pls,
+                      read_data_continuous, NULL, NULL);
+    pls->pb.pub.seekable = 0;
+    pls->cur_init_section = NULL;
+    pls->init_sec_data_len = pls->init_sec_buf_read_offset = 0;
+    pls->epoch_id = seg->epoch_id;
+    pls->epoch_started_at = seg->timeline_start;
+    pls->epoch_boundary = 0;
+    memset(pls->raw_next_valid, 0, sizeof(pls->raw_next_valid));
+    memset(pls->observed_end_valid, 0, sizeof(pls->observed_end_valid));
+    memset(pls->maximum_packet_duration, 0, sizeof(pls->maximum_packet_duration));
+    pls->ctx = avformat_alloc_context();
+    if (!pls->ctx) return AVERROR(ENOMEM);
+    pls->ctx->pb = &pls->pb.pub;
+    pls->ctx->io_open = nested_io_open;
+    pls->ctx->interrupt_callback = pls->parent->interrupt_callback;
+    pls->ctx->probesize = pls->parent->probesize;
+    pls->ctx->max_analyze_duration = pls->parent->max_analyze_duration;
+    if ((ret = ff_copy_whiteblacklists(pls->ctx, pls->parent)) < 0) return ret;
+    av_dict_copy(&options, c->seg_format_opts, 0);
+    ret = avformat_open_input(&pls->ctx, seg->url, format, &options);
+    av_dict_free(&options);
+    if (ret < 0) return ret;
+    if ((ret = avformat_find_stream_info(pls->ctx, NULL)) < 0) return ret;
+    start = epoch_presentation_start(pls->ctx);
+    if (start == AV_NOPTS_VALUE || pls->epoch_origin > INT64_MAX - pls->epoch_started_at)
+        return AVERROR_INVALIDDATA;
+    int64_t target = pls->epoch_origin + pls->epoch_started_at;
+    if ((start < 0 && target > INT64_MAX + start) || (start > 0 && target < INT64_MIN + start))
+        return AVERROR_INVALIDDATA;
+    pls->epoch_offset = target - start;
+    if ((ret = remember_epoch_clock(pls, pls->epoch_id, pls->epoch_offset, start)) < 0) return ret;
+    if (pls->ctx->nb_streams != pls->n_main_streams) return AVERROR_INVALIDDATA;
+    for (unsigned n = 0; n < pls->ctx->nb_streams; n++) {
+        AVStream *fresh = pls->ctx->streams[n], *main = pls->main_streams[n];
+        if (fresh->codecpar->codec_id != main->codecpar->codec_id ||
+            av_cmp_q(fresh->time_base, main->time_base))
+            return AVERROR_INVALIDDATA;
+    }
+    return 0;
+}
