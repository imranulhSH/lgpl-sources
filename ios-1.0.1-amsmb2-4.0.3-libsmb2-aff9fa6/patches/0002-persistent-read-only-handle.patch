+    /// Opens an existing file for bounded random reads. The returned handle
+    /// has no write API and does not reconnect or change session policy.
+    /// Share access permits server-side replacement; callers must compare a
+    /// fresh path identity with attributes().documentIdentifierKey.
+    public func openReadOnlyFile(atPath path: String) async throws -> SMB2ReadOnlyFile {
+        try await withCheckedThrowingContinuation { continuation in
+            with(completionHandler: { continuation.resume(with: $0) }) { client in
+                let file = try SMB2FileHandle(path: path, desiredAccess: .read,
+                    shareAccess: [.read, .write, .delete], createDisposition: .open, on: client)
+                return SMB2ReadOnlyFile(file: file)
+            }
+        }
+    }
