+static int epoch_audio_bounds(struct playlist *pls)
+{
+    AVPacket *pkt = pls->pkt;
+    int index = pkt->stream_index;
+    if (index < 0 || index >= 64) return AVERROR(ENOSPC);
+    AVStream *st = pls->ctx->streams[index];
+    if (st->codecpar->codec_type != AVMEDIA_TYPE_AUDIO && st->codecpar->codec_type != AVMEDIA_TYPE_VIDEO) return 0;
+    if (!pls->stream_origin_valid[index] && st->start_time != AV_NOPTS_VALUE) {
+        pls->stream_origins[index] = av_rescale_q(st->start_time, st->time_base, AV_TIME_BASE_Q) - pls->epoch_started_at;
+        int64_t epoch_ticks = av_rescale_q(pls->epoch_started_at, AV_TIME_BASE_Q, st->time_base);
+        if (epoch_ticks < 0 || st->start_time < INT64_MIN + epoch_ticks) return AVERROR_INVALIDDATA;
+        pls->stream_origin_ticks[index] = st->start_time - epoch_ticks;
+        pls->stream_origin_valid[index] = 1;
+    }
+    if (pkt->pts != AV_NOPTS_VALUE && pkt->duration > 0) {
+        int64_t start = av_rescale_q(pkt->pts, st->time_base, AV_TIME_BASE_Q);
+        int64_t duration = av_rescale_q(pkt->duration, st->time_base, AV_TIME_BASE_Q);
+        if (start > INT64_MAX - duration) return AVERROR_INVALIDDATA;
+        int64_t end = start + duration;
+        if (!pls->observed_end_valid[index] || end > pls->observed_end[index]) pls->observed_end[index] = end;
+        pls->observed_end_valid[index] = 1;
+        pls->maximum_packet_duration[index] = FFMAX(pls->maximum_packet_duration[index], duration);
+    }
+    int ret = ensure_epoch_successor(pls, index);
+    if (ret < 0) return ret;
+    if (st->codecpar->codec_type != AVMEDIA_TYPE_AUDIO || !pls->stream_origin_valid[index]) return 0;
+    int64_t boundary = AV_NOPTS_VALUE;
+    for (int n = 0; n < pls->n_segments; n++) {
+        if (pls->segments[n]->epoch_id > pls->epoch_id) {
+            boundary = pls->segments[n]->timeline_start; break;
+        }
+    }
+    if (boundary == AV_NOPTS_VALUE && pls->finished && pls->has_discontinuity && pls->n_segments) {
+        struct segment *last = pls->segments[pls->n_segments-1];
+        boundary = last->timeline_start + last->duration;
+    }
+    if (boundary == AV_NOPTS_VALUE) return 0;
+    int sample_rate = st->codecpar->sample_rate;
+    if (pkt->pts == AV_NOPTS_VALUE || pkt->duration <= 0 || sample_rate <= 0) return AVERROR_INVALIDDATA;
+    AVRational sample_time = {1, sample_rate};
+    int64_t first = av_rescale_q(pkt->pts, st->time_base, sample_time);
+    int64_t count = av_rescale_q(pkt->duration, st->time_base, sample_time);
+    /* Round the measured stream origin once in its sample time base. Rounding
+     * a negative MPEG wrap origin to microseconds and then flooring the sum
+     * would remove one real PCM sample at every epoch boundary. */
+    int64_t origin_samples = av_rescale_q(pls->stream_origin_ticks[index], st->time_base, sample_time);
+    int64_t span_samples = av_rescale_q_rnd(boundary, AV_TIME_BASE_Q, sample_time, AV_ROUND_DOWN);
+    if (origin_samples == AV_NOPTS_VALUE || span_samples < 0 || origin_samples > INT64_MAX - span_samples)
+        return AVERROR_INVALIDDATA;
+    int64_t end = origin_samples + span_samples;
+    if (count <= 0 || count > UINT32_MAX || first > INT64_MAX - count) return AVERROR_INVALIDDATA;
+    int64_t trim = first >= end ? count : FFMAX(0, first + count - end);
+    if (!trim) return 0;
+    size_t size = 0;
+    uint8_t *skip = av_packet_get_side_data(pkt, AV_PKT_DATA_SKIP_SAMPLES, &size);
+    if (skip && size < 10) return AVERROR_INVALIDDATA;
+    if (!skip) {
+        skip = av_packet_new_side_data(pkt, AV_PKT_DATA_SKIP_SAMPLES, 10);
+        if (!skip) return AVERROR(ENOMEM);
+        memset(skip, 0, 10);
+    }
+    AV_WL32(skip + 4, FFMAX((uint32_t)trim, AV_RL32(skip + 4)));
+    skip[9] = 1; /* convergence at an explicit presentation boundary */
+    return 0;
+}
