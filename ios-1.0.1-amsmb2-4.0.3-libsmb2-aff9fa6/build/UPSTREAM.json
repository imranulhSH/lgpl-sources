  "persistentReadOnlyHandle": {
    "description": "Bounded read-only pread handle on the existing authenticated session. Independent serial file queue; explicit close before session disconnect. Caller retains pre/post path stat and compares server document identifier; absent identity falls back to original per-range contents API. Guest/signing/encryption policy unchanged. Manager disconnect also drains registered path-stat/fallback operations via gracefully:true. Source close cancels active range progress flags before draining. Each wire READ is capped at 1 MiB even when the negotiated server limit is larger; a larger total range checks cancellation between chunks.",
    "validationStatus": "host_lifecycle_local_samba_and_wire_cap_unit_passed",
    "testEvidence": ".artifacts/smb-wire-cap-regression-20261001-r1/run.json",
    "tests": "SMBWireChunkTests + SMBReadAheadTests + SMBPersistentConnectionTests + SMBLiveIntegrationTests"
  },
