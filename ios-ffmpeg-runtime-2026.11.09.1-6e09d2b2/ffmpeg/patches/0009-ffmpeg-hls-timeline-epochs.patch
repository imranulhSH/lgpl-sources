+static int shift_epoch_packet(struct playlist *pls)
+{
+    AVPacket *pkt = pls->pkt;
+    int stream_index = pkt->stream_index;
+    if (stream_index < 0 || stream_index >= 64) return AVERROR(ENOSPC);
+    AVStream *stream = pls->ctx->streams[stream_index];
+    int64_t reference = pkt->pts != AV_NOPTS_VALUE ? pkt->pts : pkt->dts;
+    if (reference != AV_NOPTS_VALUE) {
+        int ret = remember_epoch_clock(pls, pls->epoch_id, pls->epoch_offset,
+            av_rescale_q(reference, stream->time_base, AV_TIME_BASE_Q));
+        if (ret < 0) return ret;
+    }
+    if (stream->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) {
+        /* Packets buffered before probing established frame_size may still
+         * have zero duration or omit redundant audio timestamps. Complete
+         * them from the now-known codec frame duration and preceding packet. */
+        if (pkt->duration <= 0 && stream->codecpar->sample_rate > 0) {
+            int samples = av_get_audio_frame_duration2(stream->codecpar, pkt->size);
+            if (samples > 0) pkt->duration = av_rescale_q(samples,
+                (AVRational){1, stream->codecpar->sample_rate}, stream->time_base);
+        }
+        if (pkt->pts == AV_NOPTS_VALUE && pls->raw_next_valid[stream_index])
+            pkt->pts = pls->raw_next_pts[stream_index];
+        if (pkt->dts == AV_NOPTS_VALUE) pkt->dts = pkt->pts;
+        if (pkt->pts != AV_NOPTS_VALUE && pkt->duration > 0) {
+            if (pkt->pts > INT64_MAX - pkt->duration) return AVERROR_INVALIDDATA;
+            pls->raw_next_pts[stream_index] = pkt->pts + pkt->duration;
+            pls->raw_next_valid[stream_index] = 1;
+        }
+    }
+    AVDictionary *metadata = NULL;
+    size_t size = 0;
+    uint8_t *previous = av_packet_get_side_data(pkt, AV_PKT_DATA_STRINGS_METADATA, &size);
+    if (previous && av_packet_unpack_dictionary(previous, size, &metadata) < 0) {
+        av_dict_free(&metadata); return AVERROR_INVALIDDATA;
+    }
+    av_dict_set_int(&metadata, "npc_hls_epoch", pls->epoch_id, 0);
+    uint8_t *packed = av_packet_pack_dictionary(metadata, &size);
+    av_dict_free(&metadata);
+    if (!packed) return AVERROR(ENOMEM);
+    if (av_packet_add_side_data(pkt, AV_PKT_DATA_STRINGS_METADATA, packed, size) < 0) {
+        av_free(packed); return AVERROR(ENOMEM);
+    }
+    int64_t shift = av_rescale_q(pls->epoch_offset, AV_TIME_BASE_Q, get_timebase(pls));
+    int64_t *timestamps[] = { &pkt->pts, &pkt->dts };
+    for (int n = 0; n < 2; n++) {
+        int64_t ts = *timestamps[n];
+        if (ts == AV_NOPTS_VALUE) continue;
+        if ((shift > 0 && ts > INT64_MAX - shift) || (shift < 0 && ts < INT64_MIN - shift))
+            return AVERROR_INVALIDDATA;
+        *timestamps[n] = ts + shift;
+    }
+    return epoch_audio_bounds(pls);
+}
