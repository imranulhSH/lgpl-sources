+int avpriv_nsurator_hls_prime_initial_subtitle(AVFormatContext *s, int stream_index,
+                                              int64_t target)
+{
+    if (!s || !s->iformat || strcmp(s->iformat->name, "hls") || stream_index < 0 ||
+        stream_index >= s->nb_streams || target == AV_NOPTS_VALUE)
+        return AVERROR(EINVAL);
+    HLSContext *c = s->priv_data;
+    struct playlist *pls = NULL;
+    int local_index = -1;
+    for (int n = 0; n < c->n_playlists; n++)
+        for (int j = 0; c->playlists[n]->is_subtitle && j < c->playlists[n]->n_main_streams; j++)
+            if (c->playlists[n]->main_streams[j]->index == stream_index) {
+                pls = c->playlists[n]; local_index = j;
+            }
+    if (!pls || !pls->n_segments) return AVERROR_INVALIDDATA;
+    if (pls->needed) return 0; /* selected before probing; already queued */
+    PacketList *queue = &ffformatcontext(s)->packet_buffer;
+    int64_t upper = target;
+    for (PacketListEntry *node = queue->head; node; node = node->next) {
+        AVPacket *p = &node->pkt;
+        if (p->stream_index < 0 || p->stream_index >= s->nb_streams) return AVERROR_INVALIDDATA;
+        int64_t pts = p->pts != AV_NOPTS_VALUE ? p->pts : p->dts;
+        if (pts != AV_NOPTS_VALUE)
+            upper = FFMAX(upper, av_rescale_q(pts, s->streams[p->stream_index]->time_base, AV_TIME_BASE_Q));
+    }
+    PacketList additions = {0};
+    int64_t saved_sequence = c->cur_seq_no;
+    int64_t deadline = av_gettime_relative() + 3 * AV_TIME_BASE;
+    size_t bytes = 0;
+    int ret = 0;
+    pls->needed = 1;
+    pls->cur_seq_no = pls->start_seq_no;
+    pls->seek_timestamp = AV_NOPTS_VALUE;
+    pls->priming_retained_subtitle_window = 1;
+    for (int count = 0; ; count++) {
+        if (count >= 4096 || av_gettime_relative() >= deadline) { ret = AVERROR(ETIMEDOUT); break; }
+        if (ff_check_interrupt(c->interrupt_callback)) { ret = AVERROR_EXIT; break; }
+        ret = read_subtitle_packet(pls, pls->pkt);
+        if (ret == AVERROR_EOF || ret == AVERROR(EAGAIN)) { ret = 0; break; }
+        if (ret < 0) break;
+        ret = shift_subtitle_epoch_packet(pls);
+        if (ret == AVERROR(EAGAIN)) { ret = 0; break; }
+        if (ret < 0) break;
+        AVPacket *p = pls->pkt;
+        if (p->stream_index != local_index || p->pts == AV_NOPTS_VALUE || p->duration <= 0) {
+            ret = AVERROR_INVALIDDATA; break;
+        }
+        AVRational time_base = pls->ctx->streams[local_index]->time_base;
+        int64_t pts = av_rescale_q(p->pts, time_base, AV_TIME_BASE_Q);
+        int64_t duration = av_rescale_q(p->duration, time_base, AV_TIME_BASE_Q);
+        if (pts == AV_NOPTS_VALUE || duration <= 0 ||
+            pts > INT64_MAX - duration) { ret = AVERROR_INVALIDDATA; break; }
+        if (av_cmp_q(time_base, s->streams[stream_index]->time_base)) {
+            ret = AVERROR_INVALIDDATA; break;
+        }
