+/* Private, versioned-with-the-host bridge. It primes only the selected
+ * rendition from its retained header window before any primary packet is
+ * handed to the consumer. Existing A/V probe packets remain owned, in order.
+ * No live media seek or assumption of equal media sequence numbers is used. */
+int avpriv_nsurator_hls_timeline_version(void);
+int avpriv_nsurator_hls_prime_initial_subtitle(AVFormatContext *s, int stream_index, int64_t target);
+
