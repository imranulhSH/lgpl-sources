+static int validate_epoch_end(struct playlist *pls, int64_t boundary)
+{
+    for (unsigned n = 0; n < pls->ctx->nb_streams; n++) {
+        if (n >= 64) return AVERROR(ENOSPC);
+        if (!pls->observed_end_valid[n] || !pls->stream_origin_valid[n]) continue;
+        if (pls->stream_origins[n] > INT64_MAX - boundary) return AVERROR_INVALIDDATA;
+        int64_t expected = pls->stream_origins[n] + boundary;
+        int64_t tolerance = FFMIN(250000, FFMAX(10000, pls->maximum_packet_duration[n])) * 2;
+        if (av_sat_sub64(pls->observed_end[n], expected) > tolerance || av_sat_sub64(expected, pls->observed_end[n]) > tolerance)
+            return AVERROR_INVALIDDATA;
+    }
+    return 0;
+}
