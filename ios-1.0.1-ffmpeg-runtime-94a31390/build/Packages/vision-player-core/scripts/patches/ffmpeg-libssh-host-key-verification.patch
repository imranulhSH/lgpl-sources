+static av_cold int libssh_close(URLContext *h)
+{
+    LIBSSHContext *libssh = h->priv_data;
+    libssh_clear_secret(&libssh->vpc_password);
+    libssh_clear_secret(&libssh->vpc_private_key_passphrase);
+    libssh_close_connection(libssh);
     return 0;
@@ -290,8 +332,44 @@
     int bytes_read;
+    uint64_t read_offset = sftp_tell64(libssh->file);

-    if ((bytes_read = sftp_read(libssh->file, buf, size)) < 0) {
-        av_log(libssh, AV_LOG_ERROR, "Read error.\n");
-        return AVERROR(EIO);
+    bytes_read = sftp_read(libssh->file, buf, size);
+    if (bytes_read >= 0)
+        return bytes_read ? bytes_read : AVERROR_EOF;
+
+    for (int attempt = 1; attempt <= libssh->reconnect_max_retries; attempt++) {
+        char path[MAX_URL_SIZE];
+        int ret;
+
+        if (ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+
+        av_log(libssh, AV_LOG_WARNING,
+               "SFTP read failed; reconnecting at the prior offset (attempt %d of %d).\n",
+               attempt, libssh->reconnect_max_retries);
+        libssh_close_connection(libssh);
+        if ((ret = libssh_connect(h, h->filename, path, sizeof(path))) < 0)
+            goto reconnect_failed;
+        if ((ret = libssh_open_file(libssh, h->flags, path)) < 0)
+            goto reconnect_failed;
+        libssh_stat_file(libssh);
+        if (sftp_seek64(libssh->file, read_offset)) {
+            ret = AVERROR(EIO);
+            goto reconnect_failed;
+        }
+
+        bytes_read = sftp_read(libssh->file, buf, size);
+        if (bytes_read >= 0) {
+            av_log(libssh, AV_LOG_INFO, "SFTP read resumed after reconnect.\n");
+            return bytes_read ? bytes_read : AVERROR_EOF;
+        }
+        continue;
+
+reconnect_failed:
+        libssh_close_connection(libssh);
+        if (ret == AVERROR_EXIT)
+            return ret;
     }
-    return bytes_read ? bytes_read : AVERROR_EOF;
+
+    av_log(libssh, AV_LOG_ERROR, "SFTP read failed after bounded reconnect attempts.\n");
+    return AVERROR(EIO);
 }
