+static int _select_button_id(GRAPHICS_CONTROLLER *gc,
+                             uint32_t button_id,
+                             int activate,
+                             GC_NAV_CMDS *cmds)
+{
+    unsigned page_id;
+    BD_IG_PAGE *page;
+    BD_IG_BUTTON *button;
+
+    if (!gc->ig_drawn || !gc->igs || !gc->igs->ics) {
+        return -1;
+    }
+
+    page_id = bd_psr_read(gc->regs, PSR_MENU_PAGE_ID);
+    page = _find_page(&gc->igs->ics->interactive_composition, page_id);
+    if (!page || !_is_button_enabled(gc, page, button_id)) {
+        return 0;
+    }
+    button = _find_button_page(page, button_id, NULL);
+    if (!button || !_find_object_for_button(gc->igs, button, BTN_SELECTED, NULL)) {
+        return 0;
+    }
+
+    _select_button(gc, button_id);
+    if (activate) {
+        return _user_input(gc, BD_VK_ENTER, cmds);
+    }
+
+    _render_page(gc, -1, cmds);
+    _reset_user_timeout(gc);
+    return 1;
+}
