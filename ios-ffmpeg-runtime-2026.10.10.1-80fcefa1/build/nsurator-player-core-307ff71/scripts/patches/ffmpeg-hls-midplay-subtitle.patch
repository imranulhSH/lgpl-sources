+int avpriv_nsurator_hls_take_primed_subtitle(AVFormatContext *s, int stream_index, AVPacket *packet);
+int avpriv_nsurator_hls_take_primed_subtitle(AVFormatContext *s, int stream_index, AVPacket *packet)
+{
+    PacketList *queue = &ffformatcontext(s)->packet_buffer;
+    PacketListEntry **position = &queue->head, *previous = NULL;
+    int scanned = 0;
+    while (*position) {
+        PacketListEntry *node = *position;
+        if (++scanned > 65536) return AVERROR(ENOSPC);
+        if (node->pkt.stream_index == stream_index) {
+            *position = node->next;
+            if (queue->tail == node) queue->tail = previous;
+            av_packet_move_ref(packet, &node->pkt);
+            av_free(node);
+            return 1;
+        }
+        previous = node; position = &node->next;
+    }
+    return 0;
+}
