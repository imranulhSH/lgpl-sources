+/* HLS timestamp mapping is opt-in; standalone WebVTT retains local time.
+ * Parse bounded decimal components rather than accepting sscanf overflows. */
+static int hls_decimal(const char **p, int64_t maximum, int64_t *out, int *digits)
+{
+    int64_t n = 0;
+    int count = 0;
+    while (**p >= '0' && **p <= '9') {
+        int digit = *(*p)++ - '0';
+        if (n > (maximum - digit) / 10)
+            return AVERROR_INVALIDDATA;
+        n = n * 10 + digit;
+        count++;
+    }
+    if (!count || n > maximum)
+        return AVERROR_INVALIDDATA;
+    *out = n;
+    if (digits) *digits = count;
+    return 0;
+}
+
+static int hls_local_timestamp(const char **p, int64_t *out)
+{
+    int64_t a, b, c = 0, ms;
+    int digits;
+    const int64_t max_hours = INT64_MAX / (3600LL * 90000) - 1;
+    if (hls_decimal(p, max_hours, &a, NULL) < 0 || *(*p)++ != ':' ||
+        hls_decimal(p, 59, &b, &digits) < 0 || digits != 2)
+        return AVERROR_INVALIDDATA;
+    if (**p == ':') {
+        ++*p;
+        if (hls_decimal(p, 59, &c, &digits) < 0 || digits != 2)
+            return AVERROR_INVALIDDATA;
+    } else {
+        if (a > 59) return AVERROR_INVALIDDATA;
+        c = b; b = a; a = 0;
+    }
+    if (*(*p)++ != '.' || hls_decimal(p, 999, &ms, &digits) < 0 || digits != 3)
+        return AVERROR_INVALIDDATA;
+    *out = ((a * 3600 + b * 60 + c) * 1000 + ms) * 90;
+    return 0;
+}
+
+static int hls_parse_timestamp_map(WebVTTContext *ctx, const char *header)
+{
+    const char *p = header;
+    int found = 0;
+    while (*p) {
+        size_t len = strcspn(p, "\r\n");
+        if (!strncmp(p, "X-TIMESTAMP-MAP=", 16)) {
+            const char *value = p + 16;
+            int have_local = 0, have_mpegts = 0;
+            int64_t local = 0, mpegts = 0;
+            if (found++) return AVERROR_INVALIDDATA;
+            for (int field = 0; field < 2; field++) {
+                while (*value == ' ' || *value == '\t') value++;
+                if (!strncmp(value, "LOCAL:", 6) && !have_local) {
+                    value += 6;
+                    if (hls_local_timestamp(&value, &local) < 0) return AVERROR_INVALIDDATA;
+                    have_local = 1;
+                } else if (!strncmp(value, "MPEGTS:", 7) && !have_mpegts) {
+                    value += 7;
+                    if (hls_decimal(&value, (1LL << 33) - 1, &mpegts, NULL) < 0) return AVERROR_INVALIDDATA;
+                    have_mpegts = 1;
+                } else return AVERROR_INVALIDDATA;
+                while (*value == ' ' || *value == '\t') value++;
+                if (field == 0 && *value++ != ',') return AVERROR_INVALIDDATA;
+            }
+            if (!have_local || !have_mpegts || value != p + len)
+                return AVERROR_INVALIDDATA;
+            if (ctx->timestamp_reference != AV_NOPTS_VALUE) {
+                int64_t delta = av_compare_mod(mpegts, ctx->timestamp_reference, 1LL << 33);
+                if ((delta > 0 && ctx->timestamp_reference > INT64_MAX - delta) ||
+                    (delta < 0 && ctx->timestamp_reference < INT64_MIN - delta))
+                    return AVERROR_INVALIDDATA;
+                mpegts = ctx->timestamp_reference + delta;
+            }
+            if (mpegts < INT64_MIN + local) return AVERROR_INVALIDDATA;
+            ctx->timestamp_offset = mpegts - local;
+        }
+        p += len;
+        while (*p == '\r' || *p == '\n') p++;
+    }
+    return 0;
+}
