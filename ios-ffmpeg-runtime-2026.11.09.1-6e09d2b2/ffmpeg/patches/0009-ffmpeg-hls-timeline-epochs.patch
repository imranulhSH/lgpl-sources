+static int parse_segment_duration(const char *text, int64_t *result)
+{
+    uint64_t seconds = 0, fraction = 0, scale = 100000;
+    const unsigned char *p = (const unsigned char *)text;
+    if (*p < '0' || *p > '9') return AVERROR_INVALIDDATA;
+    while (*p >= '0' && *p <= '9') {
+        if (seconds > ((uint64_t)INT64_MAX / AV_TIME_BASE - (*p - '0')) / 10)
+            return AVERROR_INVALIDDATA;
+        seconds = seconds * 10 + (*p++ - '0');
+    }
+    if (*p == '.') {
+        p++;
+        if (*p < '0' || *p > '9') return AVERROR_INVALIDDATA;
+        while (*p >= '0' && *p <= '9') {
+            fraction += (*p++ - '0') * scale;
+            scale /= 10;
+        }
+    }
+    if (*p && *p != ',') return AVERROR_INVALIDDATA;
+    if (seconds > (INT64_MAX - fraction) / AV_TIME_BASE) return AVERROR_INVALIDDATA;
+    *result = seconds * AV_TIME_BASE + fraction;
+    return *result > 0 ? 0 : AVERROR_INVALIDDATA;
+}
