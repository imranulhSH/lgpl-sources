+/* Bounded clock history connects external WebVTT renditions to their
+ * variant's measured MPEG clock, including probe-retained older epochs. */
+static int remember_epoch_clock(struct playlist *pls, int64_t id, int64_t offset, int64_t raw_reference)
+{
+    for (int n = 0; n < pls->epoch_clock_count; n++)
+        if (pls->epoch_clocks[n].id == id) {
+            if (pls->epoch_clocks[n].offset != offset) return AVERROR_INVALIDDATA;
+            if (pls->epoch_clocks[n].raw_reference == AV_NOPTS_VALUE)
+                pls->epoch_clocks[n].raw_reference = raw_reference;
+            return 0;
+        }
+    if (pls->epoch_clock_count == FF_ARRAY_ELEMS(pls->epoch_clocks)) {
+        memmove(pls->epoch_clocks, pls->epoch_clocks + 1,
+                sizeof(pls->epoch_clocks) - sizeof(pls->epoch_clocks[0]));
+        pls->epoch_clock_count--;
+    }
+    pls->epoch_clocks[pls->epoch_clock_count].id = id;
+    pls->epoch_clocks[pls->epoch_clock_count].offset = offset;
+    pls->epoch_clocks[pls->epoch_clock_count++].raw_reference = raw_reference;
+    return 0;
+}
+
+static int subtitle_epoch_offset(struct playlist *sub, int64_t epoch, int64_t *offset, int64_t *raw_reference)
+{
+    HLSContext *c = sub->parent->priv_data;
+    struct playlist *reference = NULL;
+    for (int n = 0; n < c->n_variants; n++) {
+        struct variant *variant = c->variants[n];
+        int contains = 0;
+        for (int j = 0; j < variant->n_playlists; j++)
+            if (variant->playlists[j] == sub) contains = 1;
+        struct playlist *main = variant->playlists[0];
+        if (contains && main->needed && !main->is_subtitle) {
+            reference = main;
+            break;
+        }
+    }
+    if (!reference) return AVERROR_INVALIDDATA;
+    for (int n = 0; n < reference->epoch_clock_count; n++)
+        if (reference->epoch_clocks[n].id == epoch) {
+            *offset = reference->epoch_clocks[n].offset;
+            if (raw_reference) {
+                *raw_reference = reference->epoch_clocks[n].raw_reference;
+                if (*raw_reference == AV_NOPTS_VALUE) return AVERROR(EAGAIN);
+            }
+            return 0;
+        }
+    /* A future epoch waits for the A/V demuxer to drain and measure its clock.
+     * A missing old epoch cannot be reconstructed from playlist durations. */
+    return !reference->epoch_active || epoch > reference->epoch_id ?
+            AVERROR(EAGAIN) : AVERROR_INVALIDDATA;
+}
+
+static int shift_subtitle_epoch_packet(struct playlist *pls)
+{
+    if (!pls->subtitle_packet_unshifted) return 0;
+    int64_t offset;
+    int ret = subtitle_epoch_offset(pls, pls->subtitle_packet_epoch, &offset, NULL);
+    if (ret < 0) return ret;
+    if (!pls->ctx || pls->pkt->stream_index < 0 || pls->pkt->stream_index >= pls->ctx->nb_streams)
+        return AVERROR_INVALIDDATA;
+    int64_t shift = av_rescale_q(offset, AV_TIME_BASE_Q,
+            pls->ctx->streams[pls->pkt->stream_index]->time_base);
+    int64_t *timestamps[] = { &pls->pkt->pts, &pls->pkt->dts };
+    for (int n = 0; n < FF_ARRAY_ELEMS(timestamps); n++) {
+        int64_t value = *timestamps[n];
+        if (value == AV_NOPTS_VALUE) continue;
+        if ((shift > 0 && value > INT64_MAX - shift) ||
+            (shift < 0 && value <= INT64_MIN - shift)) return AVERROR_INVALIDDATA;
+        *timestamps[n] = value + shift;
+    }
+    pls->subtitle_packet_unshifted = 0;
+    return 0;
+}
