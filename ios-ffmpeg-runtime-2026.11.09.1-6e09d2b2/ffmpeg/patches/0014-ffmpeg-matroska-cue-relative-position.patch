+/* An EBML number at buf (its length mark taken off) and its size in *size;
+ * -1 when buf does not hold one of at most max_size bytes. Logs nothing: a
+ * cued block's place is looked for at several candidates. */
+static int64_t matroska_peek_num(const uint8_t *buf, int left, int max_size, int *size)
+{
+    int length, i;
+    uint64_t value;
+
+    if (left < 1 || !buf[0])
+        return -1;
+    length = 8 - ff_log2_tab[buf[0]];
+    if (length > max_size || length > left)
+        return -1;
+    value = buf[0] & (0xFF >> length);
+    for (i = 1; i < length; i++)
+        value = (value << 8) | buf[i];
+    *size = length;
+    return value;
+}
+
+/* Whether buf starts the block a cue names (a SimpleBlock, or a BlockGroup
+ * whose Block comes first): the cue's track, a key frame where keyframe is
+ * asked (a SimpleBlock says it), and a time that leaves its cluster's
+ * Timestamp, the cue's time less the block's, at 0 or more. */
+static int matroska_cued_block_at(const uint8_t *buf, int left, const MatroskaCueBlock *cue,
+                                  int keyframe, uint64_t *cluster_time)
+{
+    int size, at = 0;
+    int64_t length, number;
+    int16_t block_time;
+
+    if (left < 1)
+        return 0;
+    if (buf[0] == MATROSKA_ID_BLOCKGROUP) {
+        at = 1;
+        if (matroska_peek_num(buf + at, left - at, 8, &size) < 0)
+            return 0;
+        at += size;
+        if (at >= left || buf[at] != MATROSKA_ID_BLOCK)
+            return 0;
+        keyframe = 0;
+    } else if (buf[0] != MATROSKA_ID_SIMPLEBLOCK) {
+        return 0;
+    }
+    at += 1;
+    length = matroska_peek_num(buf + at, left - at, 8, &size);
+    if (length < 4 || length == (int64_t)((1ULL << (7 * size)) - 1))
+        return 0;
+    at += size;
+    number = matroska_peek_num(buf + at, left - at, 8, &size);
+    if (number < 0 || (uint64_t)number != cue->track)
+        return 0;
+    at += size;
+    if (at + 3 > left)
+        return 0;
+    block_time = AV_RB16(buf + at);
+    if (keyframe && !(buf[at + 2] & 0x80))
+        return 0;
+    if (cue->timestamp < block_time)
+        return 0;
+    *cluster_time = cue->timestamp - block_time;
+    return 1;
+}
+
+/* Whether a cued block ended margin or more before timestamp (margin >= 0; one
+ * whose cue gives no duration has not), with no sum that can overflow. */
+static int matroska_cue_block_ended(const MatroskaCueBlock *block, int64_t timestamp,
+                                    int64_t margin)
+{
+    uint64_t since;
+
+    if (margin < 0 || !block->duration || block->timestamp > timestamp)
+        return 0;
+    since = (uint64_t)timestamp - (uint64_t)block->timestamp;
+    return since >= block->duration && since - block->duration >= (uint64_t)margin;
+}
+
+/*
+ * After a seek to a cue's cluster: when the cue says where its block sits in
+ * the cluster (CueRelativePosition), the demuxer goes on from that block, not
+ * through every block before it — megabytes, where a cluster holds several
+ * key frames — and reads nothing of the cluster before it. The block's place
+ * is the cluster's data start (past its 4-byte ID and a size of 1 to 8 bytes)
+ * plus the cue's position: one read from the first of those 8 places holds
+ * them all, and the one where the cue's track's block sits at the cue's time
+ * is taken; the cluster's Timestamp is the cue's time less that block's, and
+ * the rest of the cluster is parsed as a cluster of unknown length. That
+ * Timestamp is not read, so every cue of the cluster must agree with it: none
+ * may come before it, and the cues of the block's track must lie in the same
+ * order by place as by time (a cue whose position names another block of its
+ * track, written wrong or left from before an edit, disagrees with that
+ * block's own cue). A subtitle track being read keeps its blocks: the jump
+ * stops at the first of them its cues name in this cluster before the key
+ * frame — but for a text line whose CueDuration says it ended
+ * cue_relative_seek_subtitle_margin seconds or more before the key frame, when
+ * that is set (>= 0: the caller's subtitle delay, so it can never be shown); a
+ * bitmap set stays, as a later one may build on it — and a subtitle track
+ * without cues keeps the whole cluster. A cue without a position, no such block
+ * in one place alone, or a cue that disagrees, leaves the demuxer at the
+ * cluster's start, as before.
+ */
+static void matroska_seek_cued_block(MatroskaDemuxContext *matroska, AVStream *st,
+                                     int64_t cluster_pos, int64_t timestamp)
+{
+    AVFormatContext *s = matroska->ctx;
+    AVIOContext *pb = s->pb;
+    MatroskaCluster *cluster = &matroska->current_cluster;
+    const MatroskaCueBlock *cue = NULL, *target;
+    MatroskaTrack *track;
+    uint8_t head[40];
+    uint64_t cluster_time = 0, candidate_time;
+    int64_t first, block_pos, margin;
+    int i, j, got, found = 0, size_length = 0;
+
+    if (!matroska->cue_relative_seek || !matroska->nb_cue_blocks ||
+        !(pb->seekable & AVIO_SEEKABLE_NORMAL) ||
+        cluster_pos < 0 || cluster_pos > INT64_MAX / 2)
+        return;
+    for (i = 0; i < matroska->nb_cue_blocks; i++) {
+        const MatroskaCueBlock *block = &matroska->cue_blocks[i];
+        if (block->stream_index == st->index && block->cluster_pos == cluster_pos &&
+            block->timestamp == timestamp) {
+            cue = block;
+            break;
+        }
+    }
+    if (!cue || !cue->relative_pos)
+        return;
+    track = matroska_find_track_by_num(matroska, cue->track);
+    if (!track || track->time_scale != 1.0)
+        return;
+    target = cue;
+    margin = matroska->cue_relative_seek_subtitle_margin >= 0
+        ? llrint(matroska->cue_relative_seek_subtitle_margin * 1e9 / matroska->time_scale)
+        : -1;
+    for (i = 0; i < s->nb_streams; i++) {
+        const AVStream *other = s->streams[i];
+        const AVCodecDescriptor *descriptor;
+        int named = 0, text;
+        if (other->codecpar->codec_type != AVMEDIA_TYPE_SUBTITLE ||
+            other->discard >= AVDISCARD_ALL)
+            continue;
+        descriptor = avcodec_descriptor_get(other->codecpar->codec_id);
+        text = descriptor && (descriptor->props & AV_CODEC_PROP_TEXT_SUB);
+        for (j = 0; j < matroska->nb_cue_blocks; j++) {
+            const MatroskaCueBlock *block = &matroska->cue_blocks[j];
+            if (block->stream_index != i)
+                continue;
+            named = 1;
+            if (block->cluster_pos != cluster_pos)
+                continue;
+            if (!block->relative_pos)
+                return;
+            if (block->relative_pos >= cue->relative_pos)
+                continue;
+            if (text && matroska_cue_block_ended(block, timestamp, margin))
+                continue;
+            if (block->relative_pos < target->relative_pos)
+                target = block;
+        }
+        if (!named)
+            return;
+    }
+    if (target != cue) {
+        MatroskaTrack *subtitle = matroska_find_track_by_num(matroska, target->track);
+        if (!subtitle || subtitle->time_scale != 1.0)
+            return;
+    }
+
+    /* The 8 places the block can be, in one read. */
+    first = cluster_pos + 4 + 1 + (int64_t)target->relative_pos;
+    if (avio_seek(pb, first, SEEK_SET) != first)
+        goto restart;
+    got = avio_read(pb, head, sizeof(head));
+    if (got < 8)
+        goto restart;
+    for (i = 1; i <= 8; i++) {
+        if (matroska_cued_block_at(head + i - 1, got - (i - 1), target, target == cue &&
+                                   st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO, &candidate_time)) {
+            found++;
+            size_length = i;
+            cluster_time = candidate_time;
+        }
+    }
+    if (found != 1)
+        goto restart;
+    for (i = 0; i < matroska->nb_cue_blocks; i++) {
+        const MatroskaCueBlock *block = &matroska->cue_blocks[i];
+        if (block->cluster_pos != cluster_pos)
+            continue;
+        if (block->timestamp < 0 || (uint64_t)block->timestamp < cluster_time)
+            goto restart;
+        if (block->track != target->track || !block->relative_pos)
+            continue;
+        if (block->relative_pos == target->relative_pos) {
+            if (block->timestamp != target->timestamp)
+                goto restart;
+        } else if (block->relative_pos < target->relative_pos
+                   ? block->timestamp > target->timestamp
+                   : block->timestamp < target->timestamp) {
+            goto restart;
+        }
+    }
+    block_pos = cluster_pos + 4 + size_length + (int64_t)target->relative_pos;
+    if (matroska_reset_status(matroska, 0, block_pos) < 0)
+        goto restart;
+    matroska->levels[1] = (MatroskaLevel){ .start = cluster_pos + 4 + size_length,
+                                           .length = EBML_UNKNOWN_LENGTH };
+    matroska->num_levels = 2;
+    cluster->pos = cluster_pos;
+    cluster->timecode = cluster_time;
+    av_log(s, AV_LOG_DEBUG, "Seek to the cued block at %"PRId64", %"PRIu64
+           " bytes into its cluster at %"PRId64"\n", block_pos, target->relative_pos, cluster_pos);
+    return;
+
+restart:
+    matroska_reset_status(matroska, 0, cluster_pos);
+}
