+/* NPC_LIBBLURAY_HDMV_MENU_BUTTON_SNAPSHOT */
+static unsigned _copy_hdmv_menu_buttons(GRAPHICS_CONTROLLER *gc,
+                                        BLURAY_HDMV_MENU_BUTTON *buttons,
+                                        unsigned capacity)
+{
+    unsigned count = 0;
+
+    if (!gc || !gc->ig_drawn || !gc->igs || !gc->igs->ics || !gc->igs->complete) {
+        return 0;
+    }
+
+    unsigned page_id = bd_psr_read(gc->regs, PSR_MENU_PAGE_ID);
+    unsigned selected_button_id = bd_psr_read(gc->regs, PSR_SELECTED_BUTTON_ID);
+    BD_IG_PAGE *page = _find_page(&gc->igs->ics->interactive_composition, page_id);
+    if (!page) {
+        return 0;
+    }
+
+    unsigned ii;
+    for (ii = 0; ii < page->num_bogs; ii++) {
+        BD_IG_BOG *bog = &page->bog[ii];
+        unsigned enabled_button_id = gc->bog_data[ii].enabled_button;
+        BD_IG_BUTTON *button = _find_button_bog(bog, enabled_button_id);
+        BD_PG_OBJECT *object = button
+            ? _find_object_for_button(gc->igs, button, BTN_SELECTED, NULL)
+            : NULL;
+
+        if (!button || !object || !object->width || !object->height) {
+            continue;
+        }
+
+        if (buttons && count < capacity) {
+            buttons[count].id = button->id;
+            buttons[count].x = button->x_pos;
+            buttons[count].y = button->y_pos;
+            buttons[count].width = object->width;
+            buttons[count].height = object->height;
+            buttons[count].selected = button->id == selected_button_id;
+            buttons[count].auto_action = button->auto_action_flag;
+        }
+        count++;
     }
+    return count;
 }
 
