+static int64_t epoch_presentation_start(AVFormatContext *s)
+{
+    int64_t start = AV_NOPTS_VALUE;
+    for (unsigned n = 0; n < s->nb_streams; n++) {
+        AVStream *st = s->streams[n];
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO && st->start_time != AV_NOPTS_VALUE)
+            return av_rescale_q(st->start_time, st->time_base, AV_TIME_BASE_Q);
+    }
+    for (unsigned n = 0; n < s->nb_streams; n++) {
+        AVStream *st = s->streams[n];
+        if ((st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO || st->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) &&
+            st->start_time != AV_NOPTS_VALUE) {
+            int64_t value = av_rescale_q(st->start_time, st->time_base, AV_TIME_BASE_Q);
+            if (start == AV_NOPTS_VALUE || value < start) start = value;
+        }
+    }
+    return start;
+}
