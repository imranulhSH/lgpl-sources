+static void libssh_clear_secret(char **secret)
+{
+    if (secret && *secret) {
+        volatile unsigned char *cursor = (volatile unsigned char *)*secret;
+        size_t remaining = strlen(*secret);
+        while (remaining > 0) {
+            *cursor++ = 0;
+            remaining -= 1;
+        }
+        av_freep(secret);
+    }
+}
