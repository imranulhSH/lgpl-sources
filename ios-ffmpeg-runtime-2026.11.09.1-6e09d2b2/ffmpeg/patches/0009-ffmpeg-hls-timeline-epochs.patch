+/* Before a packet straddles the last advertised segment, learn whether its
+ * successor starts a new epoch. This barrier occurs before returning that
+ * packet to a decoder or render queue. A late live refresh stalls here with
+ * interrupt/deadline checks; it cannot retroactively alter scheduled PCM. */
+static int ensure_epoch_successor(struct playlist *pls, int stream_index)
+{
+    HLSContext *c = pls->parent->priv_data;
+    if (pls->finished || !pls->n_segments || !pls->stream_origin_valid[stream_index]) return 0;
+    AVStream *st = pls->ctx->streams[stream_index];
+    AVPacket *pkt = pls->pkt;
+    if (pkt->pts == AV_NOPTS_VALUE || pkt->duration <= 0) return AVERROR_INVALIDDATA;
+    int64_t packet_start = av_rescale_q(pkt->pts, st->time_base, AV_TIME_BASE_Q);
+    int64_t packet_duration = av_rescale_q(pkt->duration, st->time_base, AV_TIME_BASE_Q);
+    if (packet_start > INT64_MAX - packet_duration) return AVERROR_INVALIDDATA;
+    int64_t packet_end = packet_start + packet_duration;
+    int64_t deadline = av_gettime_relative() + 10 * AV_TIME_BASE;
+    int reloads = 0;
+    for (;;) {
+        struct segment *last = pls->segments[pls->n_segments - 1];
+        int64_t window_end = last->timeline_start + last->duration;
+        if (pls->stream_origins[stream_index] > INT64_MAX - window_end) return AVERROR_INVALIDDATA;
+        window_end += pls->stream_origins[stream_index];
+        if (pls->finished || packet_end < window_end) return 0;
+        if (ff_check_interrupt(c->interrupt_callback)) return AVERROR_EXIT;
+        if (av_gettime_relative() >= deadline || ++reloads > c->max_reload) return AVERROR(ETIMEDOUT);
+        int64_t interval = FFMIN(AV_TIME_BASE, FFMAX(100000, pls->target_duration / 2));
+        while (av_gettime_relative() - pls->last_load_time < interval) {
+            if (ff_check_interrupt(c->interrupt_callback)) return AVERROR_EXIT;
+            if (av_gettime_relative() >= deadline) return AVERROR(ETIMEDOUT);
+            av_usleep(10000);
+        }
+        int ret = parse_playlist(c, pls->url, pls, NULL);
+        if (ret < 0) return ret;
+    }
+}
