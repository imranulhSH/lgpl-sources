+/* NPC_LIBBLURAY_HDMV_MENU_BUTTON_SNAPSHOT */
+int bd_select_hdmv_menu_button(BLURAY *bd,
+                               int64_t pts,
+                               uint32_t button_id,
+                               int activate)
+{
+    int result = -1;
+
+    if (!bd) {
+        return -1;
     }
 
+    bd_mutex_lock(&bd->mutex);
+    _set_scr(bd, pts);
+    if (bd->title_type == title_hdmv) {
+        result = _run_gc(
+            bd,
+            activate ? GC_CTRL_BUTTON_ACTIVATE : GC_CTRL_BUTTON_SELECT,
+            button_id
+        );
+    }
     bd_mutex_unlock(&bd->mutex);
 
     return result;
